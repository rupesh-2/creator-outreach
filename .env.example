# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

APP_URL=http://localhost:3000

# LLM providers — configure at least one; choose provider/model in Settings
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Free LLM providers (OpenAI-compatible). Set any of these and pick "Free providers — auto-fallback"
# in Settings: calls go to the first one with quota left (order: Cerebras, Groq, Gemini, Mistral, NVIDIA, OpenRouter, custom).
# cloud.cerebras.ai — gpt-oss-120b, 1M tokens/day free
CEREBRAS_API_KEY=
# console.groq.com — openai/gpt-oss-120b, 200K tokens/day free
GROQ_API_KEY=
# aistudio.google.com — free-tier data may be used for training outside UK/CH/EEA/EU
GEMINI_API_KEY=
# console.mistral.ai — free "Experiment" tier; requires opting in to data training + phone verification
MISTRAL_API_KEY=
# build.nvidia.com — ~40 req/min free; phone verification
NVIDIA_API_KEY=
# openrouter.ai — ":free" models, 50 req/day (1,000/day after a $10 top-up)
OPENROUTER_API_KEY=
# Optional model overrides (defaults shown)
# CEREBRAS_MODEL=gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash   (comma-separated = try in order)
# MISTRAL_MODEL=mistral-small-latest
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Any other OpenAI-compatible endpoint (all three required)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Optional: Apify (profile/post collection)
APIFY_TOKEN=

# Optional: Resend (approved email sends)
RESEND_API_KEY=
EMAIL_FROM="Your Name <you@yourdomain.com>"

# Random strings: openssl rand -hex 32
CRON_SECRET=
UNSUBSCRIBE_SECRET=
